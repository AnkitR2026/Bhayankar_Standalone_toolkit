<?xml version='1.0' encoding='utf-8' ?>
<!-- Bhayankar extractor test fixture: synthetic workbook, not real data -->
<workbook source-build='2025.1.0' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <preferences><preference name='ui.encoding.shelf.height' value='24' /></preferences>
  <datasources>
    <datasource hasconnection='false' inline='true' name='Parameters' version='18.1'>
      <column caption='Start Date' datatype='date' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='#2026-01-01#'>
        <calculation class='tableau' formula='#2026-01-01#' />
        <range granularity='1' min='#2014-01-01#' period-type-v2='day' />
      </column>
      <column caption='End Date' datatype='date' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='#2026-11-01#'>
        <calculation class='tableau' formula='#2026-11-01#' />
      </column>
      <column caption='Unused Param' datatype='integer' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='5'>
        <calculation class='tableau' formula='5' />
      </column>
    </datasource>
    <datasource caption='ORDERS SOURCE | Project : Published' inline='true' name='sqlproxy.abc123' version='18.1'>
      <repository-location derived-from='https://server/t/site/datasources/OrdersSource' id='OrdersSource' path='/t/site/datasources' revision='1.0' site='site' />
      <connection channel='https' class='sqlproxy' dbname='OrdersSource' directory='dataserver' port='443' server='tabserver' server-ds-friendly-name='ORDERS SOURCE | Project : Published'>
        <relation name='sqlproxy' table='[sqlproxy]' type='table' />
      </connection>
      <column datatype='string' name='[Order Number]' role='dimension' type='nominal' />
      <column datatype='string' name='[Owner Name]' role='dimension' type='nominal' />
      <column datatype='string' name='[Dept Num]' role='dimension' type='nominal' />
      <column datatype='string' name='[Order Status]' role='dimension' type='nominal' />
      <column datatype='datetime' name='[Approved Date]' role='dimension' type='ordinal' />
      <column datatype='string' name='[Line Key]' role='dimension' type='nominal' />
      <column datatype='integer' name='[Line Type]' role='dimension' type='ordinal' />
      <column aggregation='Sum' datatype='real' name='[Hours]' role='measure' type='quantitative' />
      <column datatype='integer' name='[Order ID]' role='dimension' type='ordinal' />
      <column datatype='string' name='[Never Used Column]' role='dimension' type='nominal' />
      <column caption='Order Count' datatype='integer' name='[Calculation_1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Order Number])' />
      </column>
      <column caption='Type 7 Hours' datatype='real' name='[Calculation_2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Line Key]: MIN(IF [Line Type] = 7 THEN [Hours] ELSE 0 END) }' />
      </column>
      <column caption='In Window' datatype='string' name='[Calculation_3]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF&#13;&#10;// current period&#13;&#10;[Approved Date] &gt;= [Parameters].[Parameter 1] AND [Approved Date] &lt;= [Parameters].[Parameter 2] THEN "show" ELSE "hide" END' />
      </column>
      <column caption='Hours Ratio' datatype='real' name='[Calculation_4]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Hours]) / [Calculation_1] - 1' />
      </column>
      <column caption='Orphan Calc' datatype='real' name='[Calculation_5]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Hours]) * 2' />
      </column>
      <column caption='Spacer' datatype='real' name='[Calculation_6]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0.5' />
      </column>
      <column datatype='string' name='[Dept Num (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[Dept Num]' default='&quot;Other&quot;' new-bin='true'>
          <bin default-name='false' value='&quot;Design&quot;'><value>"323"</value><value>"324"</value></bin>
          <bin default-name='false' value='&quot;Lighting&quot;'><value>"313"</value></bin>
        </calculation>
      </column>
      <metadata-records>
        <metadata-record class='column'><remote-name>Order Number</remote-name><local-name>[Order Number]</local-name><parent-name>[sqlproxy]</parent-name><family>ORDERS_EDW</family><local-type>string</local-type></metadata-record>
        <metadata-record class='column'><remote-name>Owner Name</remote-name><local-name>[Owner Name]</local-name><parent-name>[sqlproxy]</parent-name><family>EMPLOYEE</family><local-type>string</local-type></metadata-record>
        <metadata-record class='column'><remote-name>Dept Num</remote-name><local-name>[Dept Num]</local-name><parent-name>[sqlproxy]</parent-name><family>EMPLOYEE</family><local-type>string</local-type></metadata-record>
        <metadata-record class='column'><remote-name>Order Status</remote-name><local-name>[Order Status]</local-name><parent-name>[sqlproxy]</parent-name><family>ORDERS_EDW</family><local-type>string</local-type></metadata-record>
        <metadata-record class='column'><remote-name>Approved Date</remote-name><local-name>[Approved Date]</local-name><parent-name>[sqlproxy]</parent-name><family>ORDERS_EDW</family><local-type>datetime</local-type></metadata-record>
        <metadata-record class='column'><remote-name>Line Key</remote-name><local-name>[Line Key]</local-name><parent-name>[sqlproxy]</parent-name><family>LINES_EDW</family><local-type>string</local-type></metadata-record>
        <metadata-record class='column'><remote-name>Line Type</remote-name><local-name>[Line Type]</local-name><parent-name>[sqlproxy]</parent-name><family>LINES_EDW</family><local-type>integer</local-type></metadata-record>
        <metadata-record class='measure'><remote-name>Hours</remote-name><local-name>[Hours]</local-name><parent-name>[sqlproxy]</parent-name><family>LINES_EDW</family><local-type>real</local-type></metadata-record>
        <metadata-record class='column'><remote-name>Order ID</remote-name><local-name>[Order ID]</local-name><parent-name>[sqlproxy]</parent-name><family>ORDERS_EDW</family><local-type>integer</local-type></metadata-record>
      </metadata-records>
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[yr:Approved Date:ok]' type='palette'>
            <map to='#1f77b4'><bucket>2025</bucket></map>
            <map to='#dbdb8d'><bucket>2026</bucket></map>
          </encoding>
        </style-rule>
      </style>
    </datasource>
  </datasources>
  <actions>
    <action caption='Open in System' name='[Action1]'>
      <source dashboard='Detail' type='sheet' worksheet='Detail Table' />
      <link caption='Open in System' expression='https://system/app?id=&lt;[Order ID]&gt;' />
    </action>
    <action caption='Drill' name='[Action2]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Main' type='sheet'><exclude-sheet name='Help' /></source>
      <command command='tsc:tsl-filter'>
        <param name='special-fields' value='all' />
        <param name='target' value='Detail' />
      </command>
    </action>
  </actions>
  <worksheets>
    <worksheet name='Owner Bars'>
      <layout-options><title><formatted-text><run>&lt;[Parameters].[Parameter 1]&gt;</run><run> to </run><run>&lt;[Parameters].[Parameter 2]&gt;</run></formatted-text></title></layout-options>
      <table>
        <view>
          <datasources><datasource caption='ORDERS SOURCE | Project : Published' name='sqlproxy.abc123' /><datasource name='Parameters' /></datasources>
          <datasource-dependencies datasource='sqlproxy.abc123'>
            <column datatype='string' name='[Owner Name]' role='dimension' type='nominal' />
            <column datatype='datetime' name='[Approved Date]' role='dimension' type='ordinal' />
            <column caption='Type 7 Hours' datatype='real' name='[Calculation_2]' role='measure' type='quantitative'><calculation class='tableau' formula='{ FIXED [Line Key]: MIN(IF [Line Type] = 7 THEN [Hours] ELSE 0 END) }' /></column>
            <column-instance column='[Owner Name]' derivation='None' name='[none:Owner Name:nk]' pivot='key' type='nominal' />
            <column-instance column='[Approved Date]' derivation='Year' name='[yr:Approved Date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_2]' derivation='Sum' name='[sum:Calculation_2:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1]' derivation='User' name='[usr:Calculation_1:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_3]' derivation='None' name='[none:Calculation_3:nk]' pivot='key' type='nominal' />
            <column-instance column='[Order Status]' derivation='None' name='[none:Order Status:nk]' pivot='key' type='nominal' />
            <column-instance column='[Dept Num (group)]' derivation='None' name='[Dept Num (group)]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[sqlproxy.abc123].[Dept Num (group)]'>
            <groupfilter function='member' level='[Dept Num (group)]' member='&quot;Design&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' />
          </filter>
          <filter class='categorical' column='[sqlproxy.abc123].[none:Calculation_3:nk]'>
            <groupfilter function='member' level='[none:Calculation_3:nk]' member='&quot;show&quot;' user:ui-enumeration='inclusive' />
          </filter>
          <filter class='categorical' column='[sqlproxy.abc123].[none:Order Status:nk]'>
            <groupfilter function='union' user:ui-enumeration='inclusive'>
              <groupfilter function='member' level='[none:Order Status:nk]' member='&quot;APPR&quot;' />
              <groupfilter from='&quot;CLOSE&quot;' function='range' level='[none:Order Status:nk]' to='&quot;WAPPR&quot;' />
            </groupfilter>
          </filter>
        </view>
        <panes>
          <pane id='1'>
            <mark class='Bar' />
            <encodings>
              <color column='[sqlproxy.abc123].[yr:Approved Date:ok]' />
              <tooltip column='[sqlproxy.abc123].[usr:Calculation_1:qk]' />
            </encodings>
            <style><style-rule element='mark'><format attr='mark-labels-show' value='true' /></style-rule></style>
          </pane>
        </panes>
        <rows>([sqlproxy.abc123].[none:Owner Name:nk] / [sqlproxy.abc123].[yr:Approved Date:ok])</rows>
        <cols>[sqlproxy.abc123].[sum:Calculation_2:qk]</cols>
      </table>
    </worksheet>
    <worksheet name='Detail Table'>
      <table>
        <view>
          <datasources><datasource caption='ORDERS SOURCE | Project : Published' name='sqlproxy.abc123' /></datasources>
          <datasource-dependencies datasource='sqlproxy.abc123'>
            <column datatype='string' name='[Order Number]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Order ID]' role='dimension' type='ordinal' />
            <column-instance column='[Order Number]' derivation='None' name='[none:Order Number:nk]' pivot='key' type='nominal' />
            <column-instance column='[Order ID]' derivation='None' name='[none:Order ID:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1]' derivation='User' name='[usr:Calculation_1:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_4]' derivation='User' name='[usr:Calculation_4:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[sqlproxy.abc123].[:Measure Names]'>
            <groupfilter function='union'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[sqlproxy.abc123].[usr:Calculation_1:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[sqlproxy.abc123].[usr:Calculation_4:qk]&quot;' />
            </groupfilter>
          </filter>
        </view>
        <panes><pane id='1'><mark class='Automatic' /><encodings><text column='[sqlproxy.abc123].[Multiple Values]' /></encodings></pane></panes>
        <rows>([sqlproxy.abc123].[none:Order Number:nk] / [sqlproxy.abc123].[none:Order ID:ok])</rows>
        <cols>[sqlproxy.abc123].[:Measure Names]</cols>
      </table>
    </worksheet>
    <worksheet name='Help'>
      <table>
        <view><datasources><datasource name='sqlproxy.abc123' /></datasources>
          <datasource-dependencies datasource='sqlproxy.abc123'>
            <column-instance column='[Calculation_6]' derivation='User' name='[usr:Calculation_6:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
        </view>
        <panes><pane id='1'><mark class='Shape' /><encodings><lod column='[sqlproxy.abc123].[none:Order Status:nk]' /></encodings><customized-tooltip><formatted-text><run>How to read this report.</run></formatted-text></customized-tooltip></pane></panes>
        <rows /><cols />
      </table>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name='Main'>
      <size maxheight='800' maxwidth='1000' minheight='800' minwidth='1000' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='10000' id='2' param='Image/logo.png' type-v2='bitmap' w='10000' x='0' y='0' />
          <zone h='10000' id='3' name='Help' w='5000' x='95000' y='0' show-title='false' />
          <zone h='8000' id='4' mode='checkdropdown' name='Owner Bars' param='[sqlproxy.abc123].[Dept Num (group)]' type-v2='filter' w='20000' x='0' y='10000' values='database' />
          <zone h='8000' id='5' mode='checkdropdown' name='Owner Bars' param='[sqlproxy.abc123].[none:Order Status:nk]' type-v2='filter' w='20000' x='20000' y='10000' />
          <zone h='8000' id='6' mode='datetime' param='[Parameters].[Parameter 1]' type-v2='paramctrl' w='15000' x='40000' y='10000' />
          <zone h='8000' id='7' mode='datetime' param='[Parameters].[Parameter 2]' type-v2='paramctrl' w='15000' x='55000' y='10000' />
          <zone h='80000' id='8' name='Owner Bars' w='100000' x='0' y='20000' />
